{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relaybench.local/schemas/h4-calibration-episode.schema.json",
  "title": "RelayBench H4 calibration episode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "run_id",
    "invocation_id",
    "test_only",
    "publishable",
    "condition",
    "horizon",
    "stress_track",
    "replicate",
    "matter",
    "stages",
    "stage_controller",
    "workspace_boundaries",
    "information_parity",
    "transferred_file_manifest",
    "verifier",
    "evaluation",
    "deterministic_score",
    "timestamps",
    "model",
    "telemetry",
    "invalid",
    "result_file"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "record_type": {"const": "h4_calibration_episode"},
    "run_id": {"type": "string", "minLength": 1},
    "invocation_id": {"type": "string", "minLength": 1},
    "test_only": {"const": true},
    "publishable": {"const": false},
    "condition": {"enum": ["C1_ORDINARY_PORTABLE", "C2_PROOFPRESS"]},
    "horizon": {"const": "H4"},
    "stress_track": {"const": "EVOLVING_NEGOTIATION_STATE"},
    "replicate": {"const": 1},
    "matter": {"type": "object"},
    "stages": {"type": "array", "minItems": 4, "maxItems": 4},
    "stage_controller": {"type": "object"},
    "workspace_boundaries": {"type": "array", "minItems": 1, "maxItems": 1},
    "information_parity": {"type": "object"},
    "transferred_file_manifest": {"type": "array", "minItems": 1},
    "verifier": {"type": "object"},
    "evaluation": {"type": "object"},
    "deterministic_score": {"type": "object"},
    "timestamps": {"type": "object"},
    "model": {"type": "object"},
    "telemetry": {"type": "object"},
    "invalid": {"type": "object"},
    "result_file": {"type": "string", "minLength": 1}
  }
}
