{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relaybench.local/schemas/benchmark-manifest.schema.json",
  "title": "RelayBench H4 frozen-manifest candidate",
  "type": "object",
  "required": [
    "schema_version",
    "benchmark",
    "proofpress_integration",
    "canonical_research_plan",
    "freeze_status",
    "upstream_proofpress",
    "harvey_lab",
    "candidate_matter",
    "scope",
    "conditions",
    "horizon",
    "information_parity",
    "cold_boundary",
    "model",
    "execution",
    "run_plan",
    "scorer",
    "invalidation_rules",
    "frozen_files"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "benchmark": {"type": "object"},
    "proofpress_integration": {"type": "object"},
    "canonical_research_plan": {"type": "object"},
    "freeze_status": {"type": "object"},
    "upstream_proofpress": {"type": "object"},
    "harvey_lab": {"type": "object"},
    "candidate_matter": {"type": "object"},
    "scope": {"type": "object"},
    "conditions": {"type": "array", "minItems": 2, "maxItems": 2},
    "horizon": {"type": "object"},
    "information_parity": {"type": "object"},
    "cold_boundary": {"type": "object"},
    "model": {"type": "object"},
    "execution": {"type": "object"},
    "run_plan": {"type": "object"},
    "scorer": {"type": "object"},
    "invalidation_rules": {"type": "array", "minItems": 1},
    "frozen_files": {"type": "array", "minItems": 1}
  }
}
