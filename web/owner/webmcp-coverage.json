  "schema_version": 1,
  "audit_note": "WebMCP completion audit: exact mounted/fresh agent identity and label; strict requested-review loading waits for committed URL, rendered receipt and title/action-note binding. Missing, mismatched and superseded requests cannot report success or show substitute decision controls.",
  "capabilities": [
    {
      "capability": "Workspace identity and Home",
      "tools": [
        "get_workspace_identity",
        "get_workspace_summary",
        "get_workspace_dashboard"
      ],
      "authority": "Read safe metadata only; unavailable data is unknown."
    },
    {
      "capability": "Knowledge and review",
      "tools": [
        "get_claim_graph",
        "list_review_queue",
        "get_current_context",
        "get_review_state",
