        "get_activity",
        "get_technical_logs",
        "get_executions"
      ],
      "authority": "Read bounded server projections; no scheduling or raw traces."
    },
    {
      "capability": "Knowledge capture rules",
      "tools": [
        "get_capture_policy",
        "prepare_capture_policy_change",
        "get_policy_history"
      ],
      "authority": "Read or stage a local draft; Owner saves."
    },
    {
      "capability": "Verification settings",
      "tools": [
        "get_review_policy",
        "prepare_review_policy_change",
        "prepare_review_criteria"
      ],
      "authority": "Live provider IDs; no keys, consent or policy saved by tools."
    },
    {
      "capability": "Agent access",
      "tools": [
        "get_agent_access",
        "prepare_agent_credential_issue"
      ],
      "authority": "Safe metadata and local draft; human issues or changes credentials."
    }
  ],
  "human_only": [
    {
      "surface": "Sign in, OAuth, bootstrap and one-time credential reveal",
      "reason": "Human privately handles authority credentials; no WebMCP secret access."
    },
    {
      "surface": "Review decisions, withdrawal, reassessment and policy activation",
      "reason": "Agent may inspect or prepare; human authority and explicit save remain required."
    },
    {
      "surface": "Credential issue, rotate, revoke and provider secret input",
      "reason": "Human-only mutations and one-time secrets; agents can inspect safe metadata."
    },
    {
      "surface": "External AI advice confirmation, recovery and retention",
      "reason": "No tool may grant processing consent, use recovery secrets or silently delete data."
    },
    {
      "surface": "Connect instructions and copy buttons",
      "reason": "Public /connect supplies client setup commands; copying is a human convenience, no new authority."
    }
  ],
