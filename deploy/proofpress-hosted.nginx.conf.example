server {
    listen 443 ssl http2;
    server_name proofpress.example.com;

    # Configure certificate paths with the deployment environment.
    ssl_certificate /etc/ssl/proofpress/fullchain.pem;
    ssl_certificate_key /etc/ssl/proofpress/private.key;

    client_max_body_size 1m;
    proxy_read_timeout 35s;

    location / {
        proxy_pass http://127.0.0.1:7334;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
}
